media:
  - name: work
    label: 案例图片
    input: assets/work
    output: /assets/work
    extensions: [jpg, jpeg, png, webp]
    rename: safe

content:
  - name: cases
    label: 公司案例
    type: file
    path: content/cases.json
    format: json
    list: true
    fields:
      - name: title
        label: 项目名称
        type: string
        required: true
      - name: slug
        label: 链接标识
        type: string
        required: true
        description: 只能用英文、数字和短横线，例如 brand-redesign
      - name: client
        label: 客户 / 品牌
        type: string
      - name: year
        label: 年份
        type: string
      - name: services
        label: 服务内容
        type: string
        list: true
      - name: summary
        label: 一句话介绍
        type: text
      - name: cover
        label: 封面图
        type: image
        required: true
      - name: challenge
        label: 项目背景 / 问题
        type: text
      - name: approach
        label: 我们做了什么
        type: text
      - name: result
        label: 项目结果
        type: text
      - name: gallery
        label: 项目图片
        type: image
        list: true
      - name: featured
        label: 在首页推荐
        type: boolean
        default: false
      - name: published
        label: 发布
        type: boolean
        default: true
      - name: order
        label: 排序
        type: number
        default: 10
        description: 数字越小越靠前
