---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="页面未找到｜牧之安 MUZHIAN" description="页面未找到。" noindex>
  <section class="page-hero" style="min-height:70svh;display:flex;align-items:center;">
    <div class="wrap">
      <p class="eyebrow">404 / NOT FOUND</p>
      <h1 style="font-size:clamp(110px, 22vw, 300px); line-height:0.8; color:var(--ink);">404</h1>
      <h2 style="margin-top:28px; font-size:clamp(34px, 5vw, 64px); line-height:1.2;">这一页，<br />还没有被安放。</h2>
      <p class="page-hero-sub">你访问的页面可能已移动、被删除，或者从来没有存在过。回到首页，继续看看我们做的事。</p>
      <div class="hero-actions">
        <a class="btn btn--fill" href="/">回到首页 <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--line" href="/work/">看看案例</a>
      </div>
    </div>
  </section>
</BaseLayout>
