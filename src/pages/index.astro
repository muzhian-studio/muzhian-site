---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
import ProjectCard from "../components/ProjectCard.astro";
import Mark from "../components/Mark.astro";
import site from "../data/site.json";
import casesData from "../data/cases.json";
import softwareData from "../data/software.json";

const cases = (casesData as any[])
  .filter((item) => item.published !== false)
  .sort((a, b) => (a.order ?? 10) - (b.order ?? 10));

const software = (softwareData as any[])
  .filter((item) => item.published !== false)
  .sort((a, b) => (a.order ?? 10) - (b.order ?? 10));

const featuredCases = cases.filter((item) => item.featured).slice(0, 3);
const featuredSoftware = software.filter((item) => item.featured).slice(0, 2);

const featuredWork = [
  ...featuredCases.map((item) => ({
    title: item.title,
    href: `/work/${item.slug}/`,
    category: item.category,
    year: item.year,
    summary: item.summary,
    cover: item.cover,
    kind: "case",
  })),
  ...featuredSoftware.map((item) => ({
    title: item.name,
    href: `/services/software/${item.slug}/`,
    category: "数字产品 / 自研",
    year: item.releaseDate,
    summary: item.summary,
    cover: item.cover,
    kind: "software",
  })),
].slice(0, 4);

const leadSoftware = software[0];
const heroItems = featuredWork.slice(0, 3);

const caseYears = cases
  .map((item) => Number.parseInt(String(item.year || "").slice(0, 4), 10))
  .filter((year) => Number.isFinite(year));
const archiveStart = caseYears.length ? Math.min(...caseYears) : 2025;
const archiveRange = `${archiveStart}—${String(new Date().getFullYear()).slice(-2)}`;

const capabilities = [
  {
    index: "01",
    title: "品牌策略与识别",
    en: "Brand strategy & identity",
    desc: "从定位、命名到视觉识别，建立清晰、一致、可以延续的品牌语言。",
    tags: ["品牌定位", "命名与话语", "视觉识别", "品牌手册"],
    href: "",
  },
  {
    index: "02",
    title: "视觉设计与内容",
    en: "Visual design & content",
    desc: "让每一次露出都准确、耐看，并保持同一种气质。",
    tags: ["平面设计", "包装物料", "数字内容", "摄影影像"],
    href: "",
  },
  {
    index: "03",
    title: "数字体验",
    en: "Digital experience",
    desc: "把品牌转译成屏幕上的节奏、界面与交互，从网站到产品界面。",
    tags: ["网站设计", "产品界面", "交互原型", "前端实现"],
    href: "",
  },
  {
    index: "04",
    title: "软件与工具",
    en: "Software & tools / sub-practice",
    desc: "当设计需要被运行起来：Windows 工具、Web 应用与内部效率产品。",
    tags: ["桌面应用", "Web 应用", "工具开发", "设计到代码"],
    href: "/services/software/",
  },
  {
    index: "05",
    title: "展览与空间叙事",
    en: "Exhibition & spatial narrative",
    desc: "在真实的空间里，安排观看的路径与情绪的起伏。",
    tags: ["策展叙事", "展陈视觉", "导视系统", "空间设计"],
    href: "",
  },
];

const method = [
  { index: "01", title: "听见", en: "Listen", body: "走进真实语境，理解目标、受众与限制。" },
  { index: "02", title: "定义", en: "Define", body: "找到核心命题，建立一句能说清的方向。" },
  { index: "03", title: "构造", en: "Build", body: "用字体、网格、色彩与材质，搭建表达系统。" },
  { index: "04", title: "落地", en: "Deliver", body: "进入真实媒介与场景，在细节里完成交付。" },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "牧之安（上海）文化创意有限公司",
  alternateName: "牧之安 MUZHIAN",
  url: "https://www.shmuzhian.cn/",
  logo: "https://www.shmuzhian.cn/assets/apple-touch-icon.png",
  description: site.seoDescription,
  foundingDate: "2025-02-11",
  email: `mailto:${site.email}`,
  identifier: "91310114MAEBHDQM6J",
  address: {
    "@type": "PostalAddress",
    streetAddress: "封周路 655 号 14 幢 201 室 J",
    addressLocality: "上海市嘉定区",
    addressRegion: "上海",
    addressCountry: "CN",
  },
};
---
<BaseLayout page="home" schema={schema}>
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">MUZHIAN / 牧之安 · 上海</p>
        <h1>
          <span class="line"><span class="line__inner">{site.heroLine}</span></span>
          <span class="line"><span class="line__inner"><em>{site.heroEmphasis}</em></span></span>
        </h1>
        <p class="hero-lead">
          {site.heroLead}
        </p>
        <div class="hero-actions">
          <a class="btn btn--fill" href="/work/">查看案例 <span class="arrow" aria-hidden="true">↘</span></a>
          <a class="text-link" href="/services/">我们做什么 <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-note">
          <span>品牌策略</span>
          <span>视觉设计</span>
          <span>数字体验</span>
          <span>软件与工具</span>
        </div>
      </div>

      <div class="hero-ledger-wrap" data-hero>
        <div class="hero-disc" aria-hidden="true"></div>
        <div class="hero-ledger">
          <div class="ledger-top">
            <span><strong>INDEX</strong> / SELECTED WORK</span>
            <span>{archiveRange}</span>
          </div>
          <div class="ledger-list">
            {heroItems.length > 0 ? (
              heroItems.map((item, i) => (
                <a
                  class:list={["ledger-item", { "is-active": i === 0 }]}
                  href={item.href}
                  data-reel-trigger
                  data-reel-index={i}
                  aria-current={i === 0 ? "true" : undefined}
                >
                  <span class="ledger-index">{String(i + 1).padStart(2, "0")}</span>
                  <span>
                    <span class="ledger-title">{item.title}</span>
                    <span class="ledger-category">{item.category}</span>
                  </span>
                  <span class="ledger-year">{item.year}</span>
                  <span class="ledger-arrow" aria-hidden="true">↗</span>
                </a>
              ))
            ) : (
              <p class="ledger-empty">项目档案正在整理。新的品牌、空间与数字产品案例会陆续出现在这里。</p>
            )}
          </div>

          {heroItems.length > 0 && (
            <div class="ledger-reel" aria-hidden="true">
              {heroItems.map((item, i) => (
                <img
                  class:list={["ledger-reel__img", { "is-active": i === 0 }]}
                  src={item.cover}
                  alt=""
                  loading="eager"
                  decoding="async"
                  data-reel-image={i}
                />
              ))}
              <span class="ledger-reel__meta">
                <span><b data-reel-current>01</b> / {String(heroItems.length).padStart(2, "0")}</span>
                <span data-reel-category>{heroItems[0]?.category || ""}</span>
              </span>
              <span class="ledger-reel__bar"><i data-reel-bar></i></span>
            </div>
          )}

          <div class="ledger-bottom">
            <span>Brand / visual / digital / software.<br />A design practice in Shanghai.</span>
          </div>
        </div>
      </div>
    </div>
    <span class="hero-side" aria-hidden="true">Independent design practice · Since 2025</span>
  </section>

  <div class="capability-marquee" aria-hidden="true">
    <div class="capability-marquee__track">
      {[...capabilities, ...capabilities].map((item) => (
        <span class="capability-marquee__item">{item.title}</span>
      ))}
    </div>
  </div>

  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <p class="section-label">01 / 精选作品</p>
        <div>
          <h2 data-reveal>先看作品，<br>再看我们<em>怎么想</em>。</h2>
          <p class="head-note" data-reveal data-reveal-delay="1">
            品牌、视觉、数字体验，以及那些最终需要被运行起来的产品。每个项目都从一个具体的问题开始。
          </p>
        </div>
      </div>

      {featuredWork.length > 1 ? (
        <div class="work-feature-grid">
          {featuredWork.map((item) => (
            <div data-reveal>
              <ProjectCard
                title={item.title}
                href={item.href}
                category={item.category}
                year={item.year}
                summary={item.summary}
                cover={item.cover}
              />
            </div>
          ))}
        </div>
      ) : featuredWork.length === 1 ? (
        <div class="work-feature">
          <ProjectCard
            title={featuredWork[0].title}
            href={featuredWork[0].href}
            category={featuredWork[0].category}
            year={featuredWork[0].year}
            summary={featuredWork[0].summary}
            cover={featuredWork[0].cover}
            wide
          />
          <div class="archive-teaser">
            <Mark class="archive-teaser__mark" />
            <div>
              <h3>更多项目，<br>正在整理。</h3>
              <p>客户项目与自主项目会按档案编号陆续补上。先看看我们正在做的事，或者直接把你的项目写给我们。</p>
              <a class="text-link" href="/work/">进入作品档案 <span class="arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      ) : (
        <div class="work-feature">
          <div class="archive-teaser">
            <Mark class="archive-teaser__mark" />
            <div>
              <h3>作品档案，<br>正在整理。</h3>
              <p>客户项目与自主项目会按档案编号陆续补上。先看看我们正在做的事，或者直接把你的项目写给我们。</p>
              <a class="text-link" href="/contact/">聊聊你的项目 <span class="arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="archive-teaser">
            <span class="label">STUDIO NOTE / 001</span>
            <div>
              <h3>设计不是装饰，<br>是让事情各得其所。</h3>
              <p>我们更愿意把每个项目当成一个完整的系统来想，而不是一张单独的图。</p>
              <a class="text-link" href="/studio/">了解工作室 <span class="arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section section--surface" id="capabilities">
    <div class="wrap">
      <div class="section-head">
        <p class="section-label">02 / 设计能力</p>
        <div>
          <h2 data-reveal>从一句话，<br>到一个完整的系统。</h2>
          <p class="head-note" data-reveal data-reveal-delay="1">
            设计是主体。软件是设计能力的延伸，是我们把界面、交互和工程实现连在一起的方式。
          </p>
        </div>
      </div>

      <div class="capability-list">
        {capabilities.map((item) => (
          item.href ? (
            <a class="capability-row" href={item.href} data-reveal>
              <span class="capability-index">{item.index}</span>
              <h3 class="capability-title">{item.title}<small>子目录 / {item.en}</small></h3>
              <p class="capability-desc">{item.desc}</p>
              <ul class="capability-tags">{item.tags.map((tag) => <li>{tag}</li>)}</ul>
              <span class="capability-arrow" aria-hidden="true">↗</span>
            </a>
          ) : (
            <div class="capability-row" data-reveal>
              <span class="capability-index">{item.index}</span>
              <h3 class="capability-title">{item.title}<small>{item.en}</small></h3>
              <p class="capability-desc">{item.desc}</p>
              <ul class="capability-tags">{item.tags.map((tag) => <li>{tag}</li>)}</ul>
              <span class="capability-arrow" aria-hidden="true">↗</span>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  {leadSoftware && (
    <section class="section digital-product">
      <div class="wrap digital-grid">
        <div class="digital-copy">
          <p class="eyebrow">DIGITAL PRODUCT / 自研工具</p>
          <h2>当设计需要<br>被<em>运行起来</em>。</h2>
          <p>{leadSoftware.summary}</p>
          <div class="digital-meta">
            <span>{leadSoftware.platform}</span>
            <span>版本 {leadSoftware.version} · {leadSoftware.releaseDate}</span>
            <span>本地处理 / 不联网</span>
          </div>
          <a class="btn btn--light" href={`/services/software/${leadSoftware.slug}/`}>
            看看 {leadSoftware.name} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="digital-visual">
          <div class="digital-frame">
            <img src={leadSoftware.cover} alt={`${leadSoftware.name} 产品界面`} loading="lazy" decoding="async" />
          </div>
          <div class="digital-caption">
            <span>BUILD / {leadSoftware.slug.toUpperCase()}</span>
            <span>WINDOWS 10 / 11</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section" id="method">
    <div class="wrap">
      <div class="section-head">
        <p class="section-label">03 / 工作方式</p>
        <div>
          <h2 data-reveal>把复杂，<br>整理成清晰。</h2>
          <p class="head-note" data-reveal data-reveal-delay="1">
            设计不是灵光一现的装饰，而是一段可以被讨论、被验证、被落地的过程。
          </p>
        </div>
      </div>
      <div class="method-list">
        {method.map((step) => (
          <article class="method-item" data-reveal>
            <div class="method-item__top"><span>{step.index}</span><i>{step.en.toUpperCase()}</i></div>
            <h3>{step.title}<small>{step.en}</small></h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--deep" id="about">
    <div class="wrap studio-grid">
      <div class="studio-poster">
        <p class="label">STUDIO NOTE / 001</p>
        <blockquote>留白不是空，<br>是让重要的东西<br><em>有呼吸</em>。</blockquote>
        <div class="studio-poster-foot">
          <span>MUZHIAN<br />SHANGHAI</span>
          <span>2025—</span>
        </div>
      </div>
      <div class="studio-copy">
        <h2 data-reveal>一间不大的工作室，<br>做一些<em>耐看</em>的设计。</h2>
        <p data-reveal data-reveal-delay="1">
          牧之安（上海）文化创意有限公司，是一家成立于 2025 年的独立设计工作室。
          我们围绕品牌、视觉、数字体验与空间叙事展开工作，也参与文化内容与展览的策划。
        </p>
        <p data-reveal data-reveal-delay="2">
          团队不大，所以我们选择项目，也选择伙伴。每一个项目，由核心成员从第一次对谈到最终落地全程参与。
          我们相信，好的合作始于彼此愿意把问题想清楚。
        </p>
        <div class="studio-facts">
          <div class="studio-fact"><strong>2025</strong><span>成立于上海</span></div>
          <div class="studio-fact"><strong>上海 · 嘉定</strong><span>工作与生活之地</span></div>
          <div class="studio-fact"><strong>独立</strong><span>小而深的工作方式</span></div>
        </div>
        <a class="text-link" href="/studio/">关于工作室 <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="contact-section" id="contact">
    <div class="wrap contact-grid">
      <div>
        <h2>有一个想法，<br><em>我们聊聊。</em></h2>
        <p class="contact-copy">
          无论是一个完整的品牌项目，还是一次尚未成形的尝试，都欢迎写信给我们。
          请简单说说你的想法、时间与预算，我们会尽快回复。
        </p>
      </div>
      <div class="contact-details">
        <div class="contact-email">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <button class="copy-btn" type="button" data-copy={site.email}>复制</button>
        </div>
        <dl class="contact-list">
          <div><dt>地址</dt><dd>{site.address}</dd></div>
          <div><dt>网站</dt><dd><a href="https://www.shmuzhian.cn">www.shmuzhian.cn</a></dd></div>
          <div><dt>状态</dt><dd>{site.availability}</dd></div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import "../scripts/home-motion.js";
</script>
