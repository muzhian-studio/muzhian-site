---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import site from "../../../data/site.json";
import softwareData from "../../../data/software.json";

const products = (softwareData as any[])
  .filter((item) => item.published !== false)
  .sort((a, b) => (a.order ?? 10) - (b.order ?? 10));
const lead = products[0];

const capabilities = [
  { title: "Windows 桌面工具", body: "从界面、交互到文件能力，做成真正可用的本地工具。" },
  { title: "Web 应用与网站", body: "把品牌、内容与功能放在同一套体验里。" },
  { title: "内部效率工具", body: "为团队的具体工作流做轻量、可靠的小产品。" },
  { title: "设计到开发", body: "从原型到实现，保持设计与代码之间的连续性。" }
];
---
<BaseLayout
  page="services"
  dark
  title="软件与工具｜牧之安 MUZHIAN"
  description="软件是设计能力在数字产品里的延伸。牧之安做 Windows 工具、Web 应用与内部效率产品。"
>
  <section class="software-hero">
    <div class="wrap">
      <p class="breadcrumb">
        <a href="/">首页</a><span class="sep">/</span>
        <a href="/services/">服务</a><span class="sep">/</span>
        <span>软件与工具</span>
      </p>
      <div class="software-hero-grid">
        <div>
          <p class="eyebrow">SUB-PRACTICE / 设计进入代码</p>
          <h1>当设计<br>进入<em>代码</em>。</h1>
          <p class="software-hero-sub">
            软件不是另一条业务线，而是设计能力的延伸。
            当界面需要被点击、被使用、被维护，我们就把它继续做下去。
          </p>
        </div>
        {lead && (
          <div class="software-hero-visual">
            <img src={lead.cover} alt={`${lead.name} 产品界面`} />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="section-label">01 / 自研产品</p>
        <div>
          <h2 data-reveal>先做给自己，<br>再拿给<em>别人用</em>。</h2>
          <p class="head-note" data-reveal data-reveal-delay="1">
            自研产品是工作室的自留地。它们不是主营业务，但同样按照完整的设计与工程标准完成。
          </p>
        </div>
      </div>

      {products.length > 0 ? (
        <div class:list={["software-products", { "is-single": products.length === 1 }]}>
          {products.map((product) => (
            <article class="product-card">
              <a class="product-card__media" href={`/services/software/${product.slug}/`} aria-label={`查看 ${product.name}`}>
                <img src={product.cover} alt={`${product.name} 产品界面`} loading="lazy" decoding="async" />
              </a>
              <div class="product-card__body">
                <p class="product-card__meta">{product.platform} / {product.version} · {product.releaseDate}</p>
                <h3>{product.name}</h3>
                <p>{product.tagline || product.summary}</p>
                <a class="text-link" href={`/services/software/${product.slug}/`}>查看产品 <span class="arrow" aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="head-note">产品正在整理中。</p>
      )}
    </div>
  </section>

  <section class="section section--surface">
    <div class="wrap">
      <div class="section-head">
        <p class="section-label">02 / 开发能力</p>
        <div>
          <h2 data-reveal>设计之后，<br>继续把它做出来。</h2>
          <p class="head-note" data-reveal data-reveal-delay="1">
            我们可以从需求梳理、界面设计一直做到可用版本。适合那些需要被认真设计，也需要被真正运行的产品。
          </p>
        </div>
      </div>
      <div class="software-capabilities">
        {capabilities.map((item, index) => (
          <article class="software-capability">
            <span>0{index + 1} / CAPABILITY</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="software-cta">
    <div class="wrap software-cta-inner">
      <div>
        <h2>有一个软件想法，<br><em>先聊聊。</em></h2>
        <p class="head-note">可以是产品、工具，或一个还在纸上的流程。我们先判断它是否值得被做出来。</p>
      </div>
      <a class="btn btn--fill" href="/contact/">联系我们 <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
