---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import softwareData from "../../../data/software.json";

export function getStaticPaths() {
  const products = (softwareData as any[]).filter((item) => item.published !== false);
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;
const taglineParts = String(product.tagline || "轻一点，看清楚。").split("，");
const firstLine = taglineParts[0];
const secondLine = taglineParts.slice(1).join("，") || "";
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: product.name,
  applicationCategory: "MultimediaApplication",
  operatingSystem: product.platform,
  softwareVersion: product.version,
  url: `https://www.shmuzhian.cn/services/software/${product.slug}/`,
  downloadUrl: `https://www.shmuzhian.cn${product.installerUrl}`,
  fileSize: "412672",
  description: product.summary,
  publisher: {
    "@type": "Organization",
    name: "牧之安（上海）文化创意有限公司",
    url: "https://www.shmuzhian.cn/"
  }
};
---
<BaseLayout
  page="services"
  dark
  title={`${product.name}｜牧之安 MUZHIAN`}
  description={product.summary}
  ogImage={product.cover || "/assets/og-dingding.jpg"}
  schema={schema}
>
  <section class="product-hero">
    <div class="wrap">
      <p class="breadcrumb">
        <a href="/">首页</a><span class="sep">/</span>
        <a href="/services/">服务</a><span class="sep">/</span>
        <a href="/services/software/">软件与工具</a><span class="sep">/</span>
        <span>{product.name}</span>
      </p>
      <div class="product-intro-grid">
        <div>
          <div class="product-lockup">
            <img src="/assets/dingding-icon.png" alt={`${product.name} 图标`} />
            <div>
              <strong>{product.name}</strong>
              <small>DINGDING VIEWER / {product.version}</small>
            </div>
          </div>
          <h1>{firstLine}{secondLine && <><br /><em>{secondLine}</em></>}</h1>
          <p class="product-hero-sub">{product.summary}</p>
          <div class="product-actions">
            <a class="btn btn--light" href="#download">下载 Windows 版 <span class="arrow" aria-hidden="true">↓</span></a>
            <a class="text-link" href="#features" style="color: var(--cream); border-color: rgba(243,239,230,.3);">查看功能 <span class="arrow" aria-hidden="true">↘</span></a>
          </div>
          <div class="product-availability">
            <span>{product.platform}</span>
            <span>版本 {product.version} · {product.releaseDate}</span>
            <span>无需登录</span>
          </div>
        </div>
        <div class="product-shot">
          <img src={product.cover} alt={`${product.name} 软件界面`} />
        </div>
      </div>
    </div>
  </section>

  <section class="product-section product-section--surface" id="features">
    <div class="wrap">
      <div class="product-section-head">
        <p class="section-label">01 / 功能</p>
        <div>
          <h2>小工具，<br />也把细节<em>做完整</em>。</h2>
          <p>{product.summary}</p>
        </div>
      </div>
      <div class="feature-grid">
        {product.features?.map((feature: any, index: number) => (
          <article class="feature-card">
            <div class="feature-card__top"><span>0{index + 1} / FEATURE</span><i>↗</i></div>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {product.screenshots?.length > 0 && (
    <section class="product-section">
      <div class="wrap">
        <div class="product-section-head">
          <p class="section-label">02 / 界面</p>
          <div>
            <h2>一扇窗，<br />装下图片与<em>文档</em>。</h2>
            <p>图片、TGA 与 PDF 放在同一套工作流里，不用在几个软件之间来回切换。</p>
          </div>
        </div>
        <div class="case-gallery" style="margin-top:0;">
          {product.screenshots.map((image: string, index: number) => (
            <figure>
              <img src={image} alt={`${product.name} 界面 ${index + 1}`} loading="lazy" />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="product-section product-section--surface" id="download">
    <div class="wrap">
      <div class="product-section-head">
        <p class="section-label">03 / 下载</p>
        <div>
          <h2>把它带走，<br />在你的电脑上<em>打开</em>。</h2>
          <p>Windows 10 / 11 · x64。选择安装版或免安装版，文件都很小。</p>
        </div>
      </div>

      <div class="download-grid">
        <article class="download-card">
          <div class="download-card__top"><span>01 / INSTALLER</span><b>推荐</b></div>
          <h3>安装版</h3>
          <p>自动安装到当前用户目录，创建桌面与开始菜单快捷方式，并注册图片和 PDF 的“打开方式”。</p>
          <a class="btn btn--light" href={product.installerUrl} download>下载安装包 <span class="arrow" aria-hidden="true">↓</span></a>
          <div class="download-card__foot"><span>dingding-viewer-1.0-setup.exe</span><span>{product.installerSize}</span></div>
        </article>
        <article class="download-card">
          <div class="download-card__top"><span>02 / PORTABLE</span></div>
          <h3>免安装版</h3>
          <p>解压后直接运行，不写系统设置，适合放在 U 盘或临时使用。</p>
          <a class="btn btn--line" href={product.portableUrl} download style="color: var(--cream); border-color: rgba(243,239,230,.4);">下载便携版 <span class="arrow" aria-hidden="true">↓</span></a>
          <div class="download-card__foot"><span>dingding-viewer-1.0-portable.zip</span><span>{product.portableSize}</span></div>
        </article>
      </div>

      <div class="product-notes">
        <div class="product-note">
          <h3>系统要求</h3>
          <p>Windows 10 版本 1809 或更高 / Windows 11；x64 处理器；需要系统自带的 .NET Framework 4.8；约 20 MB 可用空间。 <a href={product.readmeUrl}>查看使用说明 ↗</a></p>
        </div>
        <div class="product-note">
          <h3>安装提示</h3>
          <p>安装包暂未进行商业代码签名，Windows SmartScreen 可能会提示未知发布者。请仅在确认文件来源可信时继续安装。</p>
          <p><a href="/downloads/SHA256SUMS.txt">SHA-256 校验值 ↗</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="product-quote">
    <div class="wrap">
      <blockquote>认真做的小工具，<br /><em>也应该好用</em>。<cite>牧之安 / SELF-INITIATED PRODUCT</cite></blockquote>
    </div>
  </section>
</BaseLayout>
