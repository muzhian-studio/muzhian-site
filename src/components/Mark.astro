---
interface Props {
  class?: string;
}
const { class: className = "brand-mark" } = Astro.props;
---
<svg class={className} viewBox="0 0 40 40" aria-hidden="true">
  <rect class="mark-bg" x="0.5" y="0.5" width="39" height="39" rx="2.5"/>
  <path class="mark-line" d="M8.5 30V18L20 9l11.5 9v12"/>
  <path class="mark-line" d="M8.5 30h23"/>
  <circle class="mark-dot" cx="20" cy="23" r="3.6"/>
</svg>
