---
interface Props {
  variant?: "primary" | "open" | "stacked" | "mark";
  tone?: "ink" | "cream";
  class?: string;
  loading?: "eager" | "lazy";
}

const {
  variant = "primary",
  tone = "ink",
  class: className = "",
  loading = "eager",
} = Astro.props;

const assets = {
  primary: {
    ink: { src: "/assets/brand/logo-primary.svg", width: 136, height: 62 },
    cream: { src: "/assets/brand/logo-primary-dark.svg", width: 136, height: 62 },
  },
  open: {
    ink: { src: "/assets/brand/logo-open.svg", width: 146, height: 62 },
    cream: { src: "/assets/brand/logo-open-dark.svg", width: 146, height: 62 },
  },
  stacked: {
    ink: { src: "/assets/brand/logo-stacked.svg", width: 190, height: 124 },
    cream: { src: "/assets/brand/logo-stacked.svg", width: 190, height: 124 },
  },
  mark: {
    ink: { src: "/assets/brand/logo-mark.svg", width: 40, height: 40 },
    cream: { src: "/assets/brand/logo-mark.svg", width: 40, height: 40 },
  },
} as const;

const asset = assets[variant][tone];
---

<img
  src={asset.src}
  width={asset.width}
  height={asset.height}
  alt=""
  aria-hidden="true"
  class:list={["brand-logo", className]}
  loading={loading}
  decoding="async"
/>
