---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  page?: string;
  dark?: boolean;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = site.seoTitle,
  description = site.seoDescription,
  ogImage = "/assets/og-cover.jpg",
  page = "",
  dark = false,
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://www.shmuzhian.cn");
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogUrl = new URL(ogImage, siteUrl);
const jsonLd = schema ? JSON.stringify(schema) : null;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={dark ? "#101813" : "#f1ece1"} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="牧之安 MUZHIAN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header page={page} dark={dark} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="toast" role="status" aria-live="polite"></div>
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
